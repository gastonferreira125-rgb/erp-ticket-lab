      "id": "19aee36a-9310-48cd-9c02-5d5a6df3eb7a",
      "name": "Revisar prioridad"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst ticket = $input.item.json;\nconst errores = [];\n\nconst campos = [\n  \"ticket_id\",\n  \"categoria\",\n  \"prioridad\",\n  \"resumen\",\n  \"referencia_documento\",\n  \"datos_faltantes\"\n];\n\nconst categorias = [\n  \"Finanzas\", \"Ventas\", \"Inventario\",\n  \"Autorizaciones\", \"Reportes\",\n  \"Integraciones\", \"Compras\", \"Otros\"\n];\n\nconst prioridades = [\"Alta\", \"Media\", \"Baja\"];\n\n// Comprobar campos obligatorios\nfor (const campo of campos) {\n  if (!Object.hasOwn(ticket, campo)) {\n    errores.push(`Falta el campo: ${campo}`);\n  }\n}\n\n// No admitir campos adicionales\nfor (const campo of Object.keys(ticket)) {\n  if (!campos.includes(campo)) {\n    errores.push(`Campo no permitido: ${campo}`);\n  }\n}\n\n// Validar tipos y valores\nif (typeof ticket.ticket_id !== \"string\") {\n  errores.push(\"ticket_id debe ser String\");\n}\n\nif (!categorias.includes(ticket.categoria)) {\n  errores.push(\"Categoría no permitida\");\n}\n\nif (!prioridades.includes(ticket.prioridad)) {\n  errores.push(\"Prioridad no permitida\");\n}\n\nif (\n  typeof ticket.resumen !== \"string\" ||\n  ticket.resumen.length < 1\n) {\n  errores.push(\"Resumen inválido\");\n}\n\nif (\n  ticket.referencia_documento !== null &&\n  typeof ticket.referencia_documento !== \"string\"\n) {\n  errores.push(\"Referencia debe ser String o null\");\n}\n\nif (\n  !Array.isArray(ticket.datos_faltantes) ||\n  !ticket.datos_faltantes.every(\n    valor => typeof valor === \"string\"\n  )\n) {\n  errores.push(\"datos_faltantes debe ser Array de String\");\n}\n\n// Devolver datos y resultado de validación\nreturn {\n  json: {\n    ...ticket,\n    validacion_contrato: {\n      valido: errores.length === 0,\n      errores: errores\n    }\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
